# Required for deterministic secret key derivation
SESSION_SECRET=dev-secret-change-in-production

# Application environment (development or production)
APP_ENV=development

# Browser-visible application origin
APP_ORIGIN=http://127.0.0.1:3000

# Server bind address
BIND_ADDRESS=127.0.0.1:3000

# SQLite database file path
DATABASE_PATH=commoncal.sqlite

# Default admin password (sets password on the default admin user created by migration 0019).
# In production: set a strong password. In development: leave unset to use the built-in default.
DEFAULT_ADMIN_PASSWORD=

# Required in production for invitation/password-recovery accounts.
# Development enables password login automatically.
PASSWORD_LOGIN_ENABLED=true

# Production only: authenticated SMTP with verified TLS. All five are required.
# Port 465 uses implicit TLS; other ports require STARTTLS (typically 587).
# Development ignores these variables and captures messages locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# GitHub Container Registry token for `make docker-push` and CI
GHCR_TOKEN=
