# Database and encrypted backup tooling share the PostgreSQL client version.
FROM postgres:17-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends age ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/postgres/entrypoint.sh /usr/local/bin/commoncal-auth-postgres-entrypoint
COPY deploy/postgres/backup.sh /usr/local/bin/commoncal-auth-backup
COPY deploy/postgres/init-auth-role.sh /docker-entrypoint-initdb.d/10-auth-role.sh
RUN chmod 755 /usr/local/bin/commoncal-auth-postgres-entrypoint /usr/local/bin/commoncal-auth-backup /docker-entrypoint-initdb.d/10-auth-role.sh
ENTRYPOINT ["/usr/local/bin/commoncal-auth-postgres-entrypoint"]
