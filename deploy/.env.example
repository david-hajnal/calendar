# Production environment variables for deployment
# Copy to .env and set your values
SESSION_SECRET=
BACKUP_ENCRYPTION_KEY_HEX=
DOMAIN=calendar.example.com
MCP_DOMAIN=mcal.hajnal.space
MCP_OAUTH_ISSUER=https://auth.example.com
IMAGE_TAG=main
TLS_SECRET_NAME=commoncal-tls
MCP_INTERNAL_API_BASE=https://calendar.example.com
MCP_INTERNAL_API_KEY=
MCP_SESSION_SECRET=
CERT_MANAGER_ACME_EMAIL=admin@example.com
# Override only when matching cert-manager to an older supported Kubernetes release.
CERT_MANAGER_VERSION=v1.21.1
# Direct Helm mode only; rejected when Flux HelmReleases own production.
GHCR_TOKEN=
