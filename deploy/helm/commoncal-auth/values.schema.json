{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "issuer": {
      "not": {},
      "description": "Unsupported legacy key. Configure config.issuer, config.resourceUrl, and config.commoncalUrl instead."
    },
    "config": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "resourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "commoncalUrl": {
          "type": "string",
          "format": "uri"
        },
        "dcrRateLimit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
