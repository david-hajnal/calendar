{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "issuer": {
      "not": {},
      "description": "Unsupported legacy key. Configure config.issuer, config.resourceUrl, and config.commoncalUrl instead."
    },
    "config": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "resourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "commoncalUrl": {
          "type": "string",
          "format": "uri"
        },
        "dcrRateLimit": {
          "type": "integer",
          "minimum": 1
        },
        "dcrLoopbackHosts": {
          "type": "string",
          "pattern": "^(127\\.0\\.0\\.1|\\[::1\\])(,(127\\.0\\.0\\.1|\\[::1\\]))*$"
        },
        "dcrCallbackPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9/_-]+$"
        },
        "trustProxy": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bridgeKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "cookieKeysKey": {
          "type": "string",
          "minLength": 1
        },
        "jwksKey": {
          "type": "string",
          "minLength": 1
        },
        "signingKidKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "const": 1
    },
    "persistence": {
      "type": "object",
      "required": [
        "databasePath",
        "size",
        "accessModes"
      ],
      "properties": {
        "databasePath": {
          "type": "string",
          "pattern": "^/app/data/[A-Za-z0-9_.-]+\\.sqlite$"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "const": [
            "ReadWriteOnce"
          ]
        }
      },
      "additionalProperties": false
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "postgres": {
          "not": {}
        }
      }
    }
  }
}
