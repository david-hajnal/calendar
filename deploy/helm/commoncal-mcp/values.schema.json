{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "description": "SQLite-backed CommonCal MCP is a single-replica deployment.",
      "type": "integer",
      "const": 1
    },
    "persistence": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": { "type": "string", "minLength": 1 }
      }
    },
    "existingSecret": {
      "type": "object",
      "description": "Kubernetes Secret containing MCP_INTERNAL_API_KEY, MCP_SESSION_SECRET, and MCP_OAUTH_ISSUER.",
      "required": ["name", "apiKeyKeyName", "sessionSecretKeyName", "oauthIssuerKeyName"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "apiKeyKeyName": { "type": "string", "minLength": 1 },
        "sessionSecretKeyName": { "type": "string", "minLength": 1 },
        "oauthIssuerKeyName": { "type": "string", "minLength": 1 }
      }
    },
    "bindAddress": {
      "type": "string",
      "description": "Address and port to bind on.",
      "minLength": 1
    },
    "mcpDomain": {
      "type": "string",
      "description": "The public MCP domain name.",
      "minLength": 1
    },
    "publicResourceUrl": {
      "type": "string",
      "description": "The public MCP resource URL for OAuth.",
      "minLength": 1
    }
  }
}
