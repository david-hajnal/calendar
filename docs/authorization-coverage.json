{
  "schemaVersion": 1,
  "suite": "backend/tests/authorization_regression.rs",
  "principals": [
    "owner",
    "manager",
    "editor",
    "viewer",
    "free_busy_viewer",
    "unrelated",
    "suspended",
    "superadmin_without_acl"
  ],
  "endpointFamilies": {
    "calendar": ["GET /api/v1/calendars/:id", "PATCH /api/v1/calendars/:id"],
    "event": ["GET /api/v1/calendars/:calendar_id/events/:event_id", "POST /api/v1/calendars/:calendar_id/events"],
    "acl": ["GET /api/v1/calendars/:id/acl", "PUT /api/v1/calendars/:id/acl/:user_id"],
    "view": ["GET /api/v1/views/:id", "PUT /api/v1/views/:id/calendars"],
    "feed": ["GET /api/v1/calendars/:calendar_id/external-feeds", "POST /api/v1/calendars/:calendar_id/external-feeds"],
    "notification": ["service: notification planning"]
  },
  "adversarialCases": [
    "calendar identifier substitution",
    "event-to-calendar mismatch",
    "public token on authenticated endpoints",
    "non-leaking denial responses"
  ],
  "missingAuthorizationRegression": {
    "test": "missing_calendar_acl_is_denied_before_any_endpoint_can_authorize",
    "proof": "A temporary test-only mutation treated a missing ACL as Owner; this regression test failed, and the mutation was removed before this report was committed."
  }
}
