# This file is an example template only — do not deploy.
# Copy to secret.yaml and set real values before deploying.
apiVersion: v1
kind: Secret
metadata:
  name: mcp-server-secrets
  namespace: mcp-server
type: Opaque
stringData:
  MCP_INTERNAL_API_KEY: "CHANGE_ME"
  MCP_OAUTH_ISSUER: "https://auth.commoncal.tld"
  MCP_OAUTH_RESOURCE: "commoncal-mcp"
  MCP_JWKS_URL: "https://auth.commoncal.tld/.well-known/oauth-jwks"
  MCP_DB_PATH: "/data/mcp.db"
  MCP_RATE_LIMIT_WINDOW: "60"
  MCP_RATE_LIMIT_MAX_REQUESTS: "100"
